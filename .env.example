# Bilibili UP Monitor 配置
# 复制此文件为 .env 并填写实际值

# ========== 监控目标 ==========
# 逗号分隔的 UID 列表，也支持 space URL
BILIBILI_TARGET_UIDS=21424587,1309819

# ========== 监控间隔 ==========
# 支持: 1m, 5m, 10m, 15m, 30m, 1h, 2h, 6h, 12h, 24h
MONITOR_INTERVAL=5m

# ========== 数据存储 ==========
# SQLite 数据库路径 (默认: data/monitor.db)
DB_PATH=data/monitor.db

# ========== 飞书推送 ==========
# 设置为 true 启用飞书推送
ENABLE_FEISHU=false
# 飞书自定义机器人 Webhook URL (默认机器人，未分配分组的UP主使用此机器人)
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 飞书签名密钥 (可选，与 Webhook 配套)
FEISHU_WEBHOOK_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 注意: 可通过 Dashboard 的"飞书机器人分组"功能为不同UP主配置不同的飞书机器人
# 分组数据存储在数据库中，无需在 .env 中配置

# ========== 本地输出 ==========
# 设置为 true 启用本地 Markdown 报告输出
ENABLE_LOCAL_OUTPUT=true
# 本地输出目录 (默认: data/output)
LOCAL_OUTPUT_DIR=data/output

# ========== 视频下载 ==========
# 设置为 true 启用新视频自动下载
ENABLE_VIDEO_DOWNLOAD=false
# 视频下载目录 (默认: data/videos)
VIDEO_DOWNLOAD_DIR=data/videos
# 下载质量: analysis-fast (480p快速), archive (最高质量)
VIDEO_DOWNLOAD_MODE=analysis-fast

# ========== 通用 ==========
# 时区偏移 (分钟，东八区 = -480)
TIMEZONE_OFFSET=-480
# 数据保留天数
RETENTION_DAYS=30
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
